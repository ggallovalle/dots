name "kbsh"
bin "kbsh"
about "Shell toolkit"

flag "-h --help" help="Show help information"
flag "--usage-spec" help="Show the usage spec and exit"

cmd "homepath" help="Resolve and print the home-shortened path for each file" {
    flag "-h --help" help="Show help information"
    arg "<file>..." help="File paths to resolve; or - for stdin; or empty for cwd"
}
