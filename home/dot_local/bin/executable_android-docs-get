#!/usr/bin/env -S uv run --script
# vim: ft=python
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

import subprocess
import re
import sys
from pathlib import Path

OUTPUT_DIR = Path("/home/kbroom/Vaults/kbandroid/inbox")
DOCS_DIR = OUTPUT_DIR / "docs"
QUERIES_DIR = OUTPUT_DIR / "queries"


def run_android_docs(args: list[str]) -> str:
    result = subprocess.run(
        ["android"] + args,
        capture_output=True,
        text=True
    )
    return result.stdout


def parse_urls(search_output: str) -> list[tuple[str, str]]:
    """Parse numbered search results. Returns list of (url, title)."""
    urls = []
    # Match lines like: "1. Title\n   URL: kb://android/..."
    pattern = r'^\d+\.\s+(.+?)\n\s+URL:\s+(kb://.+?)$'
    for match in re.finditer(pattern, search_output, re.MULTILINE):
        title = match.group(1).strip()
        url = match.group(2).strip()
        urls.append((url, title))
    return urls


def fetch_doc(url: str) -> str:
    """Fetch doc content via android docs fetch."""
    # Pass the full URL with kb:// prefix
    return run_android_docs(["docs", "fetch", url])


def extract_title(full_output: str) -> str:
    """Extract title from CLI output (before --- separator)."""
    # Split at the separator line
    header = full_output.split("---")[0]
    # Find Title: line
    for line in header.split("\n"):
        if line.startswith("Title:"):
            # Extract and clean the title for filename
            title = line[6:].strip()
            # Remove/replace chars invalid in filenames
            title = title.replace("/", "-").replace(":", "").replace("\\", "-")
            # Limit length
            return title[:50]
    return "untitled"


def save_doc(url: str, content: str) -> tuple[Path, str]:
    """Save doc to Vault. Returns (path, title)."""
    title = extract_title(content)
    filename = f"{title}.md"
    
    # Strip CLI header - keep only content after ---
    body = content.split("---")[-1].strip()
    
    DOCS_DIR.mkdir(parents=True, exist_ok=True)
    filepath = DOCS_DIR / filename
    filepath.write_text(body)
    return filepath, title


def save_query_index(query: str, docs: list[tuple[Path, str]]) -> Path:
    """Save query index with links to fetched docs."""
    # Generate query filename
    query_filename = query.replace(" ", "-")[:50] + ".md"
    QUERIES_DIR.mkdir(parents=True, exist_ok=True)
    filepath = QUERIES_DIR / query_filename
    
    # Build Obsidian-style wiki links
    lines = [f"# {query}\n", f"> Query results from `android docs search {query}`\n"]
    for path, title in docs:
        # Link to doc relative to queries dir
        rel_path = f"../docs/{path.name}"
        lines.append(f"- [[{path.stem}|{title}]]")
    
    filepath.write_text("\n".join(lines))
    return filepath


def main() -> None:
    if len(sys.argv) < 2:
        print("Usage: android-docs-get <query>")
        sys.exit(1)
    
    query = " ".join(sys.argv[1:])
    print(f"Searching for: {query}")
    
    output = run_android_docs(["docs", "search", query])
    urls = parse_urls(output)
    
    print(f"Found {len(urls)} results, fetching...")
    
    saved_docs = []
    for url, title in urls:
        print(f"  Fetching: {title}")
        content = fetch_doc(url)
        path, doc_title = save_doc(url, content)
        saved_docs.append((path, doc_title))
        print(f"    Saved: {path}")
    
    # Save query index
    index_path = save_query_index(query, saved_docs)
    print(f"Query index: {index_path}")
    print("Done!")


if __name__ == "__main__":
    main()
