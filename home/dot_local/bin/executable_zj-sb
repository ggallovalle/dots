#!/bin/zsh
set -euo pipefail

if (( $ZELLIJ != 0 && $ZELLIJ_PANE_ID <= 0 ));then
# if (( 1 ));then
  print -u2 "error: not inside a zellij session"
  return 1
fi

TMPFILE=$(mktemp -t zellij-scrollback-XXXX.ansi)

if (( $# ));then
  zellij action focus-previous-pane
  zellij action dump-screen --full --path "$TMPFILE"
  # zellij action dump-screen --ansi --full > "$TMPFILE"
  zellij action focus-next-pane
  # nvim -R $TMPFILE
  nvim +"set ft=ansi | $" -R $TMPFILE
else
  zellij action dump-screen --pane-id=$ZELLIJ_PANE_ID --full --path "$TMPFILE" && true
  zellij action new-pane --name "scrollback" --close-on-exit --stacked -- nvim +"set ft=ansi | $" -R $TMPFILE
fi

rm $TMPFILE


