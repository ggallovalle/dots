name yt-dlp
bin yt-dlp
about "Feature-rich command-line audio/video downloader"
version "2026.03.17"
arg <URL>... help="URL(s) of the video to download; repeatable"
// General Options
flag "-h --help" help="Print this help text and exit"
flag --version help="Print program version and exit"
flag "-U --update" help="Check if updates are available"
flag --no-update help="Do not check for updates (default)"
flag "--update-to <CHANNEL_AT_TAG>" help="Upgrade/downgrade to a specific version"
flag "-i --ignore-errors" help="Ignore download and postprocessing errors"
flag --no-abort-on-error help="Continue with next video on download errors (default)"
flag --abort-on-error help="Abort downloading of further videos if an error occurs"
flag --list-extractors help="List all supported extractors and exit"
flag --extractor-descriptions help="Output descriptions of all supported extractors and exit"
flag "--use-extractors <NAMES>" help="Extractor names to use separated by commas"
flag "--default-search <PREFIX>" help="Use this prefix for unqualified URLs"
flag --ignore-config help="Don't load any more configuration files"
flag --no-config-locations help="Do not load any custom configuration files (default)"
flag "--config-locations <PATH>" help="Location of the main configuration file"
flag "--plugin-dirs <DIR>" help="Additional directory to search for plugins"
flag --no-plugin-dirs help="Clear plugin directories to search"
flag "--js-runtimes <RUNTIME[:PATH]>" help="Additional JavaScript runtime to enable"
flag --no-js-runtimes help="Clear JavaScript runtimes to enable"
flag "--remote-components <COMPONENT>" help="Remote components to allow yt-dlp to fetch"
flag --no-remote-components help="Disallow fetching of all remote components"
flag --flat-playlist help="Do not extract a playlist's URL result entries"
flag --no-flat-playlist help="Fully extract the videos of a playlist (default)"
flag --live-from-start help="Download livestreams from the start (experimental)"
flag --no-live-from-start help="Download livestreams from the current time (default)"
flag "--wait-for-video <MIN[-MAX]>" help="Wait for scheduled streams to become available"
flag --no-wait-for-video help="Do not wait for scheduled streams (default)"
flag --mark-watched help="Mark videos watched (even with --simulate)"
flag --no-mark-watched help="Do not mark videos watched (default)"
flag "--color <[STREAM:]POLICY>" help="Whether to emit color codes in output"
flag "--compat-options <OPTS>" help="Options that help keep compatibility with youtube-dl"
flag "--alias <ALIASES_OPTIONS>" help="Create aliases for an option string"
flag "-t --preset-alias <PRESET>" help="Applies a predefined set of options"
complete preset_alias run="printf '%s\n' mp3 aac mp4 mkv sleep"
// Network Options
flag "--proxy <URL>" help="Use the specified HTTP/HTTPS/SOCKS proxy"
flag "--socket-timeout <SECONDS>" help="Time to wait before giving up, in seconds"
flag "--source-address <IP>" help="Client-side IP address to bind to"
flag "--impersonate <CLIENT[:OS]>" help="Client to impersonate for requests"
flag --list-impersonate-targets help="List available clients to impersonate"
flag "-4 --force-ipv4" help="Make all connections via IPv4"
flag "-6 --force-ipv6" help="Make all connections via IPv6"
flag --enable-file-urls help="Enable file:// URLs"
// Geo-restriction
flag "--geo-verification-proxy <URL>" help="Use this proxy to verify the IP address"
flag "--xff <VALUE>" help="How to fake X-Forwarded-For HTTP header"
complete xff run="printf '%s\n' default never"
// Video Selection
flag "-I --playlist-items <ITEM_SPEC>" help="Comma-separated playlist_index of items to download"
flag "--min-filesize <SIZE>" help="Abort download if filesize is smaller than SIZE"
flag "--max-filesize <SIZE>" help="Abort download if filesize is larger than SIZE"
flag "--date <DATE>" help="Download only videos uploaded on this date"
flag "--datebefore <DATE>" help="Download only videos uploaded on or before this date"
flag "--dateafter <DATE>" help="Download only videos uploaded on or after this date"
flag "--match-filters <FILTER>" help="Generic video filter"
flag --no-match-filters help="Do not use any --match-filters (default)"
flag "--break-match-filters <FILTER>" help="Stop download when a video is rejected"
flag --no-break-match-filters help="Do not use any --break-match-filters (default)"
flag --no-playlist help="Download only the video, not the playlist"
flag --yes-playlist help="Download the playlist, if URL refers to both"
flag "--age-limit <YEARS>" help="Download only videos suitable for the given age"
flag "--download-archive <FILE>" help="Download only videos not listed in the archive file"
flag --no-download-archive help="Do not use archive file (default)"
flag "--max-downloads <NUMBER>" help="Abort after downloading NUMBER files"
flag --break-on-existing help="Stop when encountering a file that is in the archive"
flag --no-break-on-existing help="Do not stop when encountering existing file (default)"
flag --break-per-input help="Reset --max-downloads/--break-* per input URL"
flag --no-break-per-input help="Terminate entire download queue on break (default)"
flag "--skip-playlist-after-errors <N>" help="Skip playlist after N allowed failures"
// Download Options
flag "-N --concurrent-fragments <N>" help="Number of fragments to download concurrently"
flag "-r --limit-rate <RATE>" help="Maximum download rate in bytes per second"
flag "--throttled-rate <RATE>" help="Minimum download rate below which throttling is assumed"
flag "-R --retries <RETRIES>" help="Number of retries (default is 10), or 'infinite'"
flag "--file-access-retries <RETRIES>" help="Number of times to retry on file access error"
flag "--fragment-retries <RETRIES>" help="Number of retries for a fragment (default is 10)"
flag "--retry-sleep <[TYPE:]EXPR>" help="Time to sleep between retries in seconds"
flag --skip-unavailable-fragments help="Skip unavailable fragments (default)"
flag --abort-on-unavailable-fragments help="Abort download if a fragment is unavailable"
flag --keep-fragments help="Keep downloaded fragments on disk after download"
flag --no-keep-fragments help="Delete downloaded fragments after download (default)"
flag "--buffer-size <SIZE>" help="Size of download buffer (default is 1024)"
flag --resize-buffer help="Automatically resize buffer (default)"
flag --no-resize-buffer help="Do not automatically adjust the buffer size"
flag "--http-chunk-size <SIZE>" help="Size of a chunk for chunk-based HTTP downloading"
flag --playlist-random help="Download playlist videos in random order"
flag --lazy-playlist help="Process playlist entries as they are received"
flag --no-lazy-playlist help="Process playlist after it is fully parsed (default)"
flag --hls-use-mpegts help="Use mpegts container for HLS videos"
flag --no-hls-use-mpegts help="Do not use mpegts for HLS (default when not live)"
flag "--download-sections <REGEX>" help="Download only chapters matching the regex"
flag "--downloader <[PROTO:]NAME>" help="Name or path of external downloader to use"
complete downloader run="printf '%s\n' native aria2c axel curl ffmpeg httpie wget"
flag "--downloader-args <NAME:ARGS>" help="Arguments to pass to the external downloader"
// Filesystem Options
flag "-a --batch-file <FILE>" help="File containing URLs to download (one per line)"
flag --no-batch-file help="Do not read URLs from batch file (default)"
flag "-P --paths <[TYPES:]PATH>" help="Path where files should be downloaded"
flag "-o --output <[TYPES:]TEMPLATE>" help="Output filename template"
flag "--output-na-placeholder <TEXT>" help="Placeholder for unavailable fields (default: NA)"
flag --restrict-filenames help="Restrict filenames to only ASCII characters"
flag --no-restrict-filenames help="Allow Unicode and spaces in filenames (default)"
flag --windows-filenames help="Force filenames to be Windows-compatible"
flag --no-windows-filenames help="Minimally sanitize filenames"
flag "--trim-filenames <LENGTH>" help="Limit filename length (excluding extension)"
flag "-w --no-overwrites" help="Do not overwrite any files"
flag --force-overwrites help="Overwrite all video and metadata files"
flag --no-force-overwrites help="Do not overwrite video, but overwrite related files (default)"
flag "-c --continue" help="Resume partially downloaded files/fragments (default)"
flag --no-continue help="Do not resume partially downloaded fragments"
flag --part help="Use .part files while downloading (default)"
flag --no-part help="Do not use .part files"
flag --mtime help="Use Last-modified header to set file modification time"
flag --no-mtime help="Do not use Last-modified header (default)"
flag --write-description help="Write video description to a .description file"
flag --no-write-description help="Do not write video description (default)"
flag --write-info-json help="Write video metadata to a .info.json file"
flag --no-write-info-json help="Do not write video metadata (default)"
flag --write-playlist-metafiles help="Write playlist metadata alongside video metadata (default)"
flag --no-write-playlist-metafiles help="Do not write playlist metadata"
flag --clean-info-json help="Remove internal metadata from infojson (default)"
flag --no-clean-info-json help="Write all fields to the infojson"
flag --write-comments help="Retrieve video comments for the infojson"
flag --no-write-comments help="Do not retrieve video comments (default)"
flag "--load-info-json <FILE>" help="JSON file containing video information"
flag "--cookies <FILE>" help="Netscape formatted file to read cookies from"
flag --no-cookies help="Do not read/dump cookies from/to file (default)"
flag "--cookies-from-browser <BROWSER[+KEYRING][:PROFILE][::CONTAINER]>" help="Browser to load cookies from"
complete cookies_from_browser run="printf '%s\n' brave chrome chromium edge firefox opera safari vivaldi whale"
flag --no-cookies-from-browser help="Do not load cookies from browser (default)"
flag "--cache-dir <DIR>" help="Location for yt-dlp to store cached information"
flag --no-cache-dir help="Disable filesystem caching"
flag --rm-cache-dir help="Delete all filesystem cache files"
// Thumbnail Options
flag --write-thumbnail help="Write thumbnail image to disk"
flag --no-write-thumbnail help="Do not write thumbnail image to disk (default)"
flag --write-all-thumbnails help="Write all thumbnail image formats to disk"
flag --list-thumbnails help="List available thumbnails of each video"
// Internet Shortcut Options
flag --write-link help="Write an internet shortcut file"
flag --write-url-link help="Write a .url Windows internet shortcut"
flag --write-webloc-link help="Write a .webloc macOS internet shortcut"
flag --write-desktop-link help="Write a .desktop Linux internet shortcut"
// Verbosity and Simulation Options
flag "-q --quiet" help="Activate quiet mode"
flag --no-quiet help="Deactivate quiet mode (default)"
flag --no-warnings help="Ignore warnings"
flag "-s --simulate" help="Do not download or write anything to disk"
flag --no-simulate help="Download even if printing/listing options are used"
flag --ignore-no-formats-error help="Ignore 'No video formats' error (experimental)"
flag --no-ignore-no-formats-error help="Throw error when no downloadable formats (default)"
flag --skip-download help="Do not download but write related files"
flag "-O --print <[WHEN:]TEMPLATE>" help="Field name or output template to print"
flag "--print-to-file <TEMPLATE_FILE>" help="Append template output to a file"
flag "-j --dump-json" help="Print JSON information for each video"
flag "-J --dump-single-json" help="Print JSON information for each URL/playlist"
flag --force-write-archive help="Force archive entries even with --simulate"
flag --newline help="Output progress bar as new lines"
flag --no-progress help="Do not print progress bar"
flag --progress help="Show progress bar even in quiet mode"
flag --console-title help="Display progress in console titlebar"
flag "--progress-template <[TYPES:]TEMPLATE>" help="Template for progress outputs"
flag "--progress-delta <SECONDS>" help="Time between progress output (default: 0)"
flag "-v --verbose" help="Print various debugging information"
flag --dump-pages help="Print downloaded pages encoded using base64"
flag --write-pages help="Write downloaded intermediary pages to files"
flag --print-traffic help="Display sent and read HTTP traffic"
// Workarounds
flag "--encoding <ENCODING>" help="Force the specified encoding (experimental)"
flag --legacy-server-connect help="Allow HTTPS connections without RFC 5746"
flag --no-check-certificates help="Suppress HTTPS certificate validation"
flag --prefer-insecure help="Use unencrypted connection for video info"
flag "--add-headers <FIELD:VALUE>" help="Specify a custom HTTP header and its value"
flag --bidi-workaround help="Work around terminals that lack bidirectional text support"
flag "--sleep-requests <SECONDS>" help="Seconds to sleep between requests during extraction"
flag "--sleep-interval <SECONDS>" help="Seconds to sleep before each download"
flag "--max-sleep-interval <SECONDS>" help="Maximum seconds to sleep"
flag "--sleep-subtitles <SECONDS>" help="Seconds to sleep before each subtitle download"
// Video Format Options
flag "-f --format <FORMAT>" help="Video format code"
flag "-S --format-sort <SORTORDER>" help="Sort formats by the given fields"
flag --format-sort-reset help="Disregard previous user specified sort order"
flag --format-sort-force help="Force user sort order over all fields"
flag --no-format-sort-force help="Some fields have precedence over user sort (default)"
flag --video-multistreams help="Allow merging multiple video streams"
flag --no-video-multistreams help="Only one video stream per output file (default)"
flag --audio-multistreams help="Allow merging multiple audio streams"
flag --no-audio-multistreams help="Only one audio stream per output file (default)"
flag --prefer-free-formats help="Prefer free containers over non-free"
flag --no-prefer-free-formats help="No special preference for free containers (default)"
flag --check-formats help="Check if formats are actually downloadable"
flag --check-all-formats help="Check all formats for actual downloadability"
flag --no-check-formats help="Do not check that formats are downloadable"
flag "-F --list-formats" help="List available formats of each video"
flag "--merge-output-format <FORMAT>" help="Containers to use when merging formats"
complete merge_output_format run="printf '%s\n' avi flv mkv mov mp4 webm"
// Subtitle Options
flag --write-subs help="Write subtitle file"
flag --no-write-subs help="Do not write subtitle file (default)"
flag --write-auto-subs help="Write automatically generated subtitle file"
flag --no-write-auto-subs help="Do not write auto-generated subtitles (default)"
flag --list-subs help="List available subtitles of each video"
flag "--sub-format <FORMAT>" help="Subtitle format preference"
flag "--sub-langs <LANGS>" help="Languages of subtitles to download"
// Authentication Options
flag "-u --username <USERNAME>" help="Login with this account ID"
flag "-p --password <PASSWORD>" help="Account password"
flag "-2 --twofactor <TWOFACTOR>" help="Two-factor authentication code"
flag "-n --netrc" help="Use .netrc authentication data"
flag "--netrc-location <PATH>" help="Location of .netrc authentication data"
flag "--netrc-cmd <NETRC_CMD>" help="Command to get credentials for an extractor"
flag "--video-password <PASSWORD>" help="Video-specific password"
flag "--ap-mso <MSO>" help="Adobe Pass multiple-system operator identifier"
flag "--ap-username <USERNAME>" help="Multiple-system operator account login"
flag "--ap-password <PASSWORD>" help="Multiple-system operator account password"
flag --ap-list-mso help="List all supported multiple-system operators"
flag "--client-certificate <CERTFILE>" help="Path to client certificate file in PEM format"
flag "--client-certificate-key <KEYFILE>" help="Path to private key file for client certificate"
flag "--client-certificate-password <PASSWORD>" help="Password for client certificate private key"
// Post-Processing Options
flag "-x --extract-audio" help="Convert video files to audio-only (requires ffmpeg)"
flag "--audio-format <FORMAT>" help="Format to convert audio to"
complete audio_format run="printf '%s\n' best aac alac flac m4a mp3 opus vorbis wav"
flag "--audio-quality <QUALITY>" help="ffmpeg audio quality (0=best to 10=worst, or bitrate)"
flag "--remux-video <FORMAT>" help="Remux video into another container"
complete remux_video run="printf '%s\n' avi flv gif mkv mov mp4 webm aac aiff alac flac m4a mka mp3 ogg opus vorbis wav"
flag "--recode-video <FORMAT>" help="Re-encode video into another format"
flag "--postprocessor-args <NAME:ARGS>" help="Arguments to pass to postprocessors"
flag "-k --keep-video" help="Keep intermediate video file after post-processing"
flag --no-keep-video help="Delete intermediate video after post-processing (default)"
flag --post-overwrites help="Overwrite post-processed files (default)"
flag --no-post-overwrites help="Do not overwrite post-processed files"
flag --embed-subs help="Embed subtitles in the video"
flag --no-embed-subs help="Do not embed subtitles (default)"
flag --embed-thumbnail help="Embed thumbnail in the video as cover art"
flag --no-embed-thumbnail help="Do not embed thumbnail (default)"
flag --embed-metadata help="Embed metadata to the video file"
flag --no-embed-metadata help="Do not add metadata to file (default)"
flag --embed-chapters help="Add chapter markers to the video file"
flag --no-embed-chapters help="Do not add chapter markers (default)"
flag --embed-info-json help="Embed infojson as an attachment to mkv/mka"
flag --no-embed-info-json help="Do not embed infojson as attachment"
flag "--parse-metadata <[WHEN:]FROM:TO>" help="Parse additional metadata from other fields"
flag "--replace-in-metadata <[WHEN:]FIELDS_REGEX_REPLACE>" help="Replace text in a metadata field using regex"
flag --xattrs help="Write metadata to the video file's xattrs"
flag "--concat-playlist <POLICY>" help="Concatenate videos in a playlist"
complete concat_playlist run="printf '%s\n' never always multi_video"
flag "--fixup <POLICY>" help="Automatically correct known faults of the file"
complete fixup run="printf '%s\n' never warn detect_or_warn force"
flag "--ffmpeg-location <PATH>" help="Location of ffmpeg binary"
flag "--exec <[WHEN:]CMD>" help="Execute a command after download"
flag --no-exec help="Remove any previously defined --exec"
flag "--convert-subs <FORMAT>" help="Convert subtitles to another format"
complete convert_subs run="printf '%s\n' ass lrc srt vtt none"
flag "--convert-thumbnails <FORMAT>" help="Convert thumbnails to another format"
complete convert_thumbnails run="printf '%s\n' jpg png webp none"
flag --split-chapters help="Split video into multiple files based on chapters"
flag --no-split-chapters help="Do not split video based on chapters (default)"
flag "--remove-chapters <REGEX>" help="Remove chapters whose title matches the regex"
flag --no-remove-chapters help="Do not remove chapters (default)"
flag --force-keyframes-at-cuts help="Force keyframes at cuts (slow, needs re-encode)"
flag --no-force-keyframes-at-cuts help="Do not force keyframes around cuts (default)"
flag "--use-postprocessor <NAME[:ARGS]>" help="Plugin postprocessors to enable"
// SponsorBlock Options
flag "--sponsorblock-mark <CATS>" help="SponsorBlock categories to create chapters for"
complete sponsorblock_mark run="printf '%s\n' sponsor intro outro selfpromo preview filler interaction music_offtopic hook poi_highlight chapter all default"
flag "--sponsorblock-remove <CATS>" help="SponsorBlock categories to remove from video"
complete sponsorblock_remove run="printf '%s\n' sponsor intro outro selfpromo preview filler interaction music_offtopic hook all default"
flag "--sponsorblock-chapter-title <TEMPLATE>" help="Output template for SponsorBlock chapter titles"
flag --no-sponsorblock help="Disable both --sponsorblock-mark and --sponsorblock-remove"
flag "--sponsorblock-api <URL>" help="SponsorBlock API location"
// Extractor Options
flag "--extractor-retries <RETRIES>" help="Number of retries for known extractor errors"
flag --allow-dynamic-mpd help="Process dynamic DASH manifests (default)"
flag --ignore-dynamic-mpd help="Do not process dynamic DASH manifests"
flag --hls-split-discontinuity help="Split HLS playlists at discontinuities"
flag --no-hls-split-discontinuity help="Do not split HLS playlists (default)"
flag "--extractor-args <IE_KEY:ARGS>" help="Pass arguments to the IE_KEY extractor"
