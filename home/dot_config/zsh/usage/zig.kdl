cmd "ast-check" help="Look for simple compile errors in any set of files" {
    arg "[<file>]" help="Input file (default: stdin)"
    flag "--color <mode>" help="Enable or disable colored error messages"
    complete "mode" run="""
        printf '%s\n' 'auto:auto' 'off:off' 'on:on'
        """ descriptions=#true
    flag "--zon" help="Treat the input file as ZON, regardless of file extension"
    flag "-t" help="(debug option) Output ZIR in text form to stdout"
}

cmd "fmt" help="Reformat Zig source into canonical form" {
    arg "[<files>...]" help="Files or directories to format"
    flag "--color <mode>" help="Enable or disable colored error messages"
    complete "mode" run="""
        printf '%s\n' 'auto:auto' 'off:off' 'on:on'
        """ descriptions=#true
    flag "--stdin" help="Format code from stdin; output to stdout"
    flag "--check" help="List non-conforming files and exit with an error if the list is non-empty"
    flag "--ast-check" help="Run zig ast-check on every file"
    flag "--exclude <file>" help="Exclude file or directory from formatting"
    flag "--zon" help="Treat all input files as ZON, regardless of file extension"
}

cmd "reduce" help="Minimize a bug report" {
    arg "<file>" help="Zig source file to reduce"
}

cmd "translate-c" help="Convert C code to Zig code" {
    arg "[<file>]" help="C source file"
    flag "-j <N>" help="Limit concurrent jobs"
    flag "--color <mode>" help="Enable or disable colored error messages"
    complete "mode" run="""
        printf '%s\n' 'auto:auto' 'off:off' 'on:on'
        """ descriptions=#true
    flag "---femit-bin[=<path>]" help="(default) Output machine code"
    flag "---fno-emit-bin" help="Do not output machine code"
    flag "--cache-dir <path>" help="Override the local cache directory"
    flag "--global-cache-dir <path>" help="Override the global cache directory"
    flag "--zig-lib-dir <path>" help="Override path to Zig installation lib directory"
    flag "---target <name>" help="<arch><sub>-<os>-<abi> see the targets command"
    flag "-I <dir>" help="Add directory to include search path"
    flag "-D <macro>=<value>" help="Define C macro to value (1 if value omitted)"
    flag "---cflags <flags>" help="Set extra flags for the next positional C source files"
}

cmd "ar" help="Combine object files into static archive" {
    arg "<operation>[<modifiers>]" help="Operation with optional modifiers (e.g. rcs)"
    arg "<archive>" help="Archive file"
    arg "[<files>...]" help="Files to operate on"
    flag "--format <format>" help="Archive format to create"
    complete "format" run="""
        printf '%s\n' \
          'default:default' 'gnu:gnu' 'darwin:darwin' \
          'bsd:bsd' 'bigarchive:big archive (AIX)' 'coff:coff'
        """ descriptions=#true
    flag "--plugin=<string>" help="Ignored for compatibility"
    flag "--output <dir>" help="The directory to extract archive members to"
    flag "--thin" help="Create a thin archive"
    flag "--rsp-quoting <style>" help="Quoting style for response files"
    complete "style" run="""
        printf '%s\n' 'posix:posix' 'windows:windows'
        """ descriptions=#true
    flag "---X{32|64|32_64|any}" help="Object mode (AIX OS only)"
}

cmd "cc" help="Use Zig as a drop-in C compiler" {
    arg "[<files>...]" help="Source files"
    // Delegates to Clang/LLVM; accepts all common C compiler flags
}

cmd "c++" help="Use Zig as a drop-in C++ compiler" {
    arg "[<files>...]" help="Source files"
    // Delegates to Clang/LLVM; accepts all common C++ compiler flags
}

cmd "dlltool" help="Use Zig as a drop-in dlltool.exe" {
    arg "[<options>] <file>" help="Input file"
    flag "-D <value>" help="Specify the input DLL Name"
    flag "-d <value>" help="Input .def File"
    flag "-f <value>" help="Assembler Flags"
    flag "-I <value>" help="Identify DLL name from import library"
    flag "-k" help="Kill @n Symbol from export"
    flag "-l <value>" help="Generate an import lib"
    flag "-m <value>" help="Set target machine"
    complete "value" run="""
        printf '%s\n' 'i386:i386' 'i386:x86-64:x86-64' 'arm:arm' 'arm64:arm64' 'arm64ec:arm64ec' 'r4000:r4000'
        """ descriptions=#true
    flag "--no-leading-underscore" help="Don't add leading underscores on symbols"
    flag "-N <value>" help="Input native .def File on ARM64EC"
    flag "-S <value>" help="Assembler"
    flag "-t <value>" help="Prefix for temporary files (ignored)"
    flag "--identify-strict" help="Error out if --identify detects more than one DLL"
}

cmd "lib" help="Use Zig as a drop-in lib.exe" {
    arg "[<files>...]" help="Object files"
}

cmd "objcopy" help="Manipulate executables and relocatables" {
    arg "[<options>] <infile>" help="Input file"
    arg "[<outfile>]" help="Output file"
}

cmd "objdump" help="Print information about executables and relocatables" {
    arg "<file>" help="File to dump"
}

cmd "ranlib" help="Use Zig as a drop-in ranlib" {
    arg "<archive...>" help="Archive files"
    flag "-D" help="Use zero for timestamps and uids/gids (default)"
    flag "-U" help="Use actual timestamps and uids/gids"
}

cmd "rc" help="Use Zig as a drop-in rc.exe" {
    arg "[<files>...]" help="Resource files"
}

cmd "env" help="Print lib path, std path, cache directory, and version" {
}

cmd "help" help="Print this help and exit" {
    arg "[<command>]" help="Show help for a specific command"
}

cmd "std" help="View standard library documentation in a browser" {
    arg "[<symbol>]" help="Specific symbol to look up"
    flag "--color <mode>" help="Enable or disable colored error messages"
    flag "--cache-dir <path>" help="Override the local cache directory"
    flag "--global-cache-dir <path>" help="Override the global cache directory"
    flag "--zig-lib-dir <path>" help="Override path to Zig installation lib directory"
}

cmd "libc" help="Display native libc paths file or validate one" {
    arg "[<file>]" help="libc path file to validate (omit to display native paths)"
}

cmd "targets" help="List available compilation targets" {
}

cmd "version" help="Print version number and exit" {
}

cmd "zen" help="Print Zen of Zig and exit" {
}
