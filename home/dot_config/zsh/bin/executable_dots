#!/usr/bin/env zsh

emulate -L zsh

if (( ! ${+commands[chezmoi]} )); then
  print -u2 "dots: chezmoi command not found in PATH"
  return 127
fi
# yellow

_dots_infer_apply_path() {
  local cwd="$PWD"
  local resolved=""

  if resolved="$(chezmoi target-path "$cwd" 2>/dev/null)"; then
    print -r -- "$resolved"
    return 0
  fi

  if chezmoi source-path "$cwd" >/dev/null 2>&1; then
    print -r -- "$cwd"
    return 0
  fi

  print -u2 "dots: could not infer chezmoi path from $cwd"
  return 1
}

_dots_diff_inferred_path() {
  local inferred_path="$1"

  if [[ -d "$inferred_path" ]]; then
    local -a managed_files
    managed_files=( ${(f)$(chezmoi managed --include=files --path-style=absolute "$inferred_path" 2>/dev/null)} )

    if (( ${#managed_files} > 0 )); then
      local path
      for path in "${managed_files[@]}"; do
        chezmoi diff "$path" || return $?
      done
      return 0
    fi
  fi

  chezmoi diff "$inferred_path"
}

_dots_help() {
  cat <<'EOF'
Usage:
  dots                Show this help message
  dots apply [PATH]   Apply chezmoi changes
  dots diff [PATH]    Diff chezmoi changes

Behavior:
  - If PATH is provided, it is passed through to chezmoi.
  - If PATH is omitted, dots infers it from the current directory.
EOF
}

local cmd=""
if (( $# > 0 )); then
  cmd="$1"
  shift
fi

case "$cmd" in
  "")
    _dots_help
    ;;
  apply|diff)
    if (( $# > 0 )); then
      chezmoi "$cmd" "$@"
      return $?
    fi

    local inferred_path
    inferred_path="$(_dots_infer_apply_path)" || return 1
    if [[ "$cmd" == "diff" ]]; then
      _dots_diff_inferred_path "$inferred_path"
      return $?
    fi

    chezmoi "$cmd" "$inferred_path"
    ;;
  -h|--help|help)
    _dots_help
    ;;
  *)
    print -u2 "dots: unknown command '$cmd'"
    _dots_help
    return 1
    ;;
esac
