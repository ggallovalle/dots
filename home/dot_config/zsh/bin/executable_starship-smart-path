#!/usr/bin/env zsh

emulate -L zsh
setopt extendedglob

local cur_path name value best_name best_value best_len

cur_path=${PWD:A}

typeset -A xdg_paths=(
  '$XDG_CONFIG_HOME' "${XDG_CONFIG_HOME:-$HOME/.config}"
  '$XDG_CACHE_HOME'  "${XDG_CACHE_HOME:-$HOME/.cache}"
  '$XDG_DATA_HOME'   "${XDG_DATA_HOME:-$HOME/.local/share}"
  '$XDG_STATE_HOME'  "${XDG_STATE_HOME:-$HOME/.local/state}"
  '$XDG_BIN_HOME'    "${XDG_BIN_HOME:-$HOME/.local/bin}"
  '$GHQ_ROOT'        "${GHQ_ROOT:-$HOME/ghq}"
  '$DOTFILES'        "${DOTFILES:-$HOME/dots}"
  '$HOME'            "$HOME"
)

best_name=''
best_value=''
best_len=0

for name value in ${(kv)xdg_paths}; do
  value=${value:A}

  if [[ $cur_path == $value(|/*) && ${#value} -gt $best_len ]]; then
    best_name=$name
    best_value=$value
    best_len=${#value}
  fi
done

if [[ -n $best_name ]]; then
  if [[ $cur_path == $best_value ]]; then
    print -rn -- "$best_name"
  else
    print -rn -- "$best_name/${cur_path#$best_value/}"
  fi
else
  print -rn -- "$cur_path"
fi
