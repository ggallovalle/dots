{
  "$schema": "https://opencode.ai/config.json",
  // "model": "minimax/MiniMax-M2.7",
  // "model": "openai/gpt-5.3-codex",
  "model": "opencode/deepseek-v4-flash-free",
  "autoupdate": true,
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "server": {
    "port": 4096
  },
  "default_agent": "build",
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "permission": {
        "external_directory": {
          "/tmp/**": "allow",
          "$HOME/dev/kbroom/**": "allow",
          "$HOME/.config/**": "allow",
          "$HOME/.local/share/go/**": "allow",
          "$HOME/.local/share/mise/installs/**": "allow",
          "$HOME/.luarocks/**": "allow",
          "$HOME/dotfiles/**": "allow",
          "$HOME/.zi/**": "allow",
          "$HOME/.local/share/opencode/**": "allow",
          "$HOME/ghq/**": "allow",
          "$HOME/.local/share/nvim/**": "allow"
        }
      }
    }
  }
}
