#compdef kbzsh
# @generated by usage-cli from usages/kbzsh.usage.kdl
local curcontext="$curcontext"

_kbzsh() {
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in kbzsh." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_file="${TMPDIR:-/tmp}/usage__usage_spec_kbzsh.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name kbzsh
bin kbzsh
version "0.0.1"
author "Gerson Gallo"
about "kbzsh CLI — manage zsh config, run functions, generate completions"
license MIT
flag "-h --help" help="Show help information"
flag --version help="Show version information"
flag --completions help="Print shell completion script" {
    arg <shell>
}
cmd secrets help="Work with system secrets" {
    cmd get help="Get a secret value" {
        flag --redacted help="Show the value in a redacted form"
        arg <service> help="The service"
        arg <key> help="The key"
    }
}
__USAGE_EOF__
  local -a completions=()
  while IFS= read -r line; do
    completions+=("$line")
  done < <(command usage complete-word --shell zsh -f "$spec_file" -- "${words[@]}")
  _describe 'completions' completions -S ''
  return 0
}

if [ "$funcstack[1]" = "_kbzsh" ]; then
    _kbzsh "$@"
else
    compdef _kbzsh kbzsh
fi

